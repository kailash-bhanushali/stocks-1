ALPACA_API_KEY=your_alpaca_api_key_id_here
ALPACA_SECRET_KEY=your_alpaca_secret_key_here
ALPACA_PAPER=True
ALPACA_BASE_URL=https://paper-api.alpaca.markets
ALPACA_TRADING_ENABLED=false
ALPACA_STOCK_FEED=iex
ALPACA_OPTION_FEED=indicative
ALPACA_OPTION_STREAM_FEED=indicative

# Optional read-only market data fallbacks. Keep real keys in .env only.
FINNHUB_API_KEY=
ALPHA_VANTAGE_API_KEY=
MASSIVE_API_KEY=

# Required before a TradingView webhook can be treated as real/verified.
TRADINGVIEW_WEBHOOK_SECRET=replace_with_a_long_random_secret

# Risk cap used by the options validation gate before any Alpaca phase.
MAX_OPTION_PREMIUM=1000
